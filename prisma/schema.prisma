generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users & Auth ───────────────────────────────────────────

enum UserRole {
  ADMIN
  B2B
  AFFILIATE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  role         UserRole   @default(B2B)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  b2bAccount       B2BAccount?
  affiliateProfile AffiliateProfile?
  b2bNotesAuthored B2BNote[]          @relation("NoteAuthor")
  reviewedApps     B2BApplication[]   @relation("AppReviewer")
  contentUpdates   ContentBlock[]     @relation("ContentUpdater")

  @@map("users")
}

// ─── Products & Collections ─────────────────────────────────

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  imageUrl     String?  @map("image_url")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  description     String?       @db.Text
  specs           Json?
  categoryId      String        @map("category_id")
  basePrice       Decimal       @map("base_price") @db.Decimal(10, 2)
  amazonUrl       String?       @map("amazon_url")
  etsyUrl         String?       @map("etsy_url")
  metaTitle       String?       @map("meta_title")
  metaDescription String?       @map("meta_description") @db.Text
  ogImage         String?       @map("og_image")
  status          ProductStatus @default(DRAFT)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  category    Category          @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  tierPricing B2BTierPricing[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id           String  @id @default(cuid())
  productId    String  @map("product_id")
  url          String
  altText      String? @map("alt_text")
  displayOrder Int     @default(0) @map("display_order")
  isPrimary    Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id            String  @id @default(cuid())
  productId     String  @map("product_id")
  name          String
  sku           String  @unique
  priceModifier Decimal @default(0) @map("price_modifier") @db.Decimal(10, 2)
  specs         Json?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

// ─── B2B ────────────────────────────────────────────────────

enum BusinessType {
  HOTEL
  CAFE
  RESTAURANT
  RETAILER
  WHOLESALER
  DISTRIBUTOR
  INTERIOR_DESIGNER
  ARCHITECT
  OTHER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model B2BApplication {
  id                   String            @id @default(cuid())
  companyName          String            @map("company_name")
  businessType         BusinessType      @map("business_type")
  gstNumber            String?           @map("gst_number")
  yearEstablished      Int?              @map("year_established")
  websiteUrl           String?           @map("website_url")
  contactName          String            @map("contact_name")
  contactDesignation   String?           @map("contact_designation")
  email                String
  phone                String
  categoriesInterested Json?             @map("categories_interested")
  estimatedVolume      String?           @map("estimated_volume")
  currentSuppliers     String?           @map("current_suppliers")
  heardAbout           String?           @map("heard_about")
  deliveryCity         String?           @map("delivery_city")
  deliveryState        String?           @map("delivery_state")
  orderFrequency       String?           @map("order_frequency")
  gstCertificateUrl    String?           @map("gst_certificate_url")
  status               ApplicationStatus @default(PENDING)
  reviewedById         String?           @map("reviewed_by_id")
  reviewedAt           DateTime?         @map("reviewed_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  reviewedBy B2BAccount? @relation("ApplicationAccount")
  reviewer   User?       @relation("AppReviewer", fields: [reviewedById], references: [id])
  notes      B2BNote[]

  @@index([status])
  @@map("b2b_applications")
}

enum AccountTier {
  RETAILER
  DISTRIBUTOR
  HOTEL_CAFE
  CUSTOM
}

model B2BAccount {
  id                 String      @id @default(cuid())
  applicationId      String      @unique @map("application_id")
  userId             String      @unique @map("user_id")
  tier               AccountTier @default(RETAILER)
  discountPercentage Decimal     @default(0) @map("discount_percentage") @db.Decimal(5, 2)
  status             UserStatus  @default(ACTIVE)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  application   B2BApplication @relation("ApplicationAccount", fields: [applicationId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  orderRequests OrderRequest[]

  @@map("b2b_accounts")
}

model B2BTierPricing {
  id        String      @id @default(cuid())
  productId String      @map("product_id")
  tier      AccountTier
  minQty    Int         @map("min_qty")
  maxQty    Int?        @map("max_qty")
  unitPrice Decimal     @map("unit_price") @db.Decimal(10, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, tier, minQty])
  @@index([productId])
  @@map("b2b_tier_pricing")
}

enum OrderStatus {
  SUBMITTED
  ACKNOWLEDGED
  INVOICED
  FULFILLED
  CANCELLED
}

model OrderRequest {
  id           String      @id @default(cuid())
  b2bAccountId String      @map("b2b_account_id")
  status       OrderStatus @default(SUBMITTED)
  items        Json
  total        Decimal     @db.Decimal(12, 2)
  notes        String?     @db.Text
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  b2bAccount B2BAccount @relation(fields: [b2bAccountId], references: [id])

  @@index([b2bAccountId])
  @@index([status])
  @@map("order_requests")
}

model B2BNote {
  id            String   @id @default(cuid())
  applicationId String   @map("application_id")
  authorId      String   @map("author_id")
  content       String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  application B2BApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User           @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([applicationId])
  @@map("b2b_notes")
}

// ─── Affiliates ─────────────────────────────────────────────

model AffiliateApplication {
  id           String            @id @default(cuid())
  name         String
  email        String
  phone        String?
  socialUrl    String?           @map("social_url")
  audienceSize String?           @map("audience_size")
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  profile AffiliateProfile?

  @@index([status])
  @@map("affiliate_applications")
}

model AffiliateProfile {
  id                String   @id @default(cuid())
  applicationId     String   @unique @map("application_id")
  userId            String   @unique @map("user_id")
  uniqueCode        String   @unique @map("unique_code")
  discountPercent   Decimal  @default(5) @map("discount_percent") @db.Decimal(5, 2)
  commissionPercent Decimal  @default(2) @map("commission_percent") @db.Decimal(5, 2)
  status            UserStatus @default(ACTIVE)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  application AffiliateApplication @relation(fields: [applicationId], references: [id])
  user        User                 @relation(fields: [userId], references: [id])
  salesLogs   AffiliateSalesLog[]

  @@map("affiliate_profiles")
}

enum Platform {
  AMAZON
  ETSY
}

enum PaymentStatus {
  PENDING
  PAID
}

model AffiliateSalesLog {
  id              String        @id @default(cuid())
  affiliateId     String        @map("affiliate_id")
  period          String
  platform        Platform
  redemptionCount Int           @default(0) @map("redemption_count")
  revenue         Decimal       @db.Decimal(12, 2)
  commissionOwed  Decimal       @map("commission_owed") @db.Decimal(12, 2)
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  paidAt          DateTime?     @map("paid_at")
  notes           String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")

  affiliate AffiliateProfile @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
  @@map("affiliate_sales_logs")
}

// ─── Content & SEO ──────────────────────────────────────────

enum ContentType {
  TEXT
  IMAGE
  URL
}

model ContentBlock {
  id          String      @id @default(cuid())
  key         String      @unique
  value       String      @db.Text
  type        ContentType @default(TEXT)
  updatedById String?     @map("updated_by_id")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  updatedBy User? @relation("ContentUpdater", fields: [updatedById], references: [id])

  @@map("content_blocks")
}

model SeoDefault {
  id              String   @id @default(cuid())
  titleTemplate   String   @map("title_template")
  metaDescription String   @map("meta_description") @db.Text
  ogImage         String?  @map("og_image")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("seo_defaults")
}

model SeoOverride {
  id              String  @id @default(cuid())
  pagePath        String  @unique @map("page_path")
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description") @db.Text
  ogImage         String? @map("og_image")

  @@map("seo_overrides")
}

// ─── Analytics Events ───────────────────────────────────────

model MarketplaceClick {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  platform  Platform
  country   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([createdAt])
  @@map("marketplace_clicks")
}
