# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# On Vercel use the TRANSACTION POOLER url (port 6543), NOT the direct
# db.<ref>.supabase.co host (that host is IPv6-only and unreachable from Vercel).
DATABASE_URL="postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres"

# ─── Auth (NextAuth v5) ───────────────────────────────────────────────────────
# Session/JWT signing secret. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"
# Canonical app URL. LOCAL ONLY — omit this on Vercel (it is inferred there).
AUTH_URL="http://localhost:3000"

# ─── Seed admin credentials ───────────────────────────────────────────────────
# Email + password for the admin user created by `npm run db:seed`.
ADMIN_EMAIL="admin@draveta.com"
# Seed admin password; defaults to admin123 if unset.
ADMIN_PASSWORD="admin123"

# ─── Cloudflare R2 (OPTIONAL) ─────────────────────────────────────────────────
# All R2 vars are optional — direct image uploads were removed in favor of image
# links, so these can be left empty.
R2_ACCOUNT_ID=""            # Cloudflare account id
R2_ACCESS_KEY_ID=""         # R2 access key id
R2_SECRET_ACCESS_KEY=""     # R2 secret access key
R2_BUCKET_NAME=""           # R2 bucket name
R2_PUBLIC_URL=""            # Public base URL for the bucket

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Optional — if unset, outbound emails are logged to the console instead of sent.
RESEND_API_KEY=""
